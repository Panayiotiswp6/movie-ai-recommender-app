<script>

/* =========================================================
   API
========================================================= */

const API_URL =
    "https://movie-mind-api.pankouzaris.workers.dev/";


/* =========================================================
   CATEGORY NAMES
========================================================= */

const PICK_GENRE_NAMES = {

    "science-fiction":
        "Science Fiction",

    "thriller":
        "Thriller",

    "action":
        "Action",

    "drama":
        "Drama",

    "comedy":
        "Comedy",

    "horror":
        "Horror",

    "romance":
        "Romance",

    "mystery":
        "Mystery",

    "adventure":
        "Adventure",

    "fantasy":
        "Fantasy"

};


/* =========================================================
   ELEMENTS
========================================================= */

const aiButton =
    document.getElementById(
        "aiModeButton"
    );


const picksButton =
    document.getElementById(
        "picksModeButton"
    );


const aiMode =
    document.getElementById(
        "aiMode"
    );


const picksMode =
    document.getElementById(
        "picksMode"
    );


const exploreButton =
    document.getElementById(
        "exploreButton"
    );


/* =========================================================
   MODE SWITCH
========================================================= */

function showMode(mode){

    const showPicks =
        mode === "picks";


    aiMode.classList.toggle(
        "active",
        !showPicks
    );


    picksMode.classList.toggle(
        "active",
        showPicks
    );


    aiButton.classList.toggle(
        "active",
        !showPicks
    );


    picksButton.classList.toggle(
        "active",
        showPicks
    );


    if(showPicks){

        displayPicks();

        setTimeout(
            () => {

                picksMode.scrollIntoView({
                    behavior:"smooth",
                    block:"start"
                });

            },
            30
        );

    }else{

        aiMode.scrollIntoView({
            behavior:"smooth",
            block:"start"
        );

    }

}


aiButton.addEventListener(
    "click",
    () => showMode("ai")
);


picksButton.addEventListener(
    "click",
    () => showMode("picks")
);


/* =========================================================
   EXPLORE
========================================================= */

exploreButton.addEventListener(
    "click",
    () => {

        aiMode.scrollIntoView({
            behavior:"smooth",
            block:"start"
        });

    }
);


/* =========================================================
   AI RECOMMENDER
========================================================= */

async function findMovies(){

    const results =
        document.getElementById(
            "results"
        );


    const loading =
        document.getElementById(
            "loading"
        );


    const out =
        document.getElementById(
            "movieResults"
        );


    const button =
        document.getElementById(
            "recommendButton"
        );


    results.style.display =
        "block";


    loading.style.display =
        "block";


    out.style.display =
        "none";


    out.innerHTML =
        "";


    button.disabled =
        true;


    button.textContent =
        "SEARCHING...";


    try{

        const response =
            await fetch(
                API_URL,
                {

                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({

                            genre:
                                document
                                    .getElementById(
                                        "genre"
                                    )
                                    .value,

                            period:
                                document
                                    .getElementById(
                                        "period"
                                    )
                                    .value,

                            plotTwist:
                                document
                                    .getElementById(
                                        "plotTwist"
                                    )
                                    .value,

                            favoriteMovies:[

                                document
                                    .getElementById(
                                        "favorite1"
                                    )
                                    .value
                                    .trim(),

                                document
                                    .getElementById(
                                        "favorite2"
                                    )
                                    .value
                                    .trim(),

                                document
                                    .getElementById(
                                        "favorite3"
                                    )
                                    .value
                                    .trim()

                            ].filter(Boolean)

                        })

                }
            );


        const data =
            await response.json();


        if(
            !response.ok ||
            !data.success
        ){

            throw new Error(
                data.error ||
                "MovieMind could not find recommendations."
            );

        }


        out.innerHTML =
            (data.recommendations || [])
                .map(
                    movie => `

                        <article
                            class="movie-card"
                        >

                            ${
                                movie.poster_path

                                ?

                                `
                                <img
                                    src="https://image.tmdb.org/t/p/w342${movie.poster_path}"
                                    alt="${escapeAttr(
                                        movie.title
                                    )}"
                                    loading="lazy"
                                >
                                `

                                :

                                ``
                            }


                            <div
                                class="movie-info"
                            >

                                <h3>

                                    ${escapeHtml(
                                        movie.title
                                    )}

                                </h3>


                                <div
                                    class="movie-meta"
                                >

                                    ${escapeHtml(
                                        movie.year || ""
                                    )}

                                </div>


                                <div
                                    class="movie-rating"
                                >

                                    ★

                                    ${Number(
                                        movie.rating || 0
                                    ).toFixed(1)}

                                </div>


                                <div
                                    class="movie-reason"
                                >

                                    ${escapeHtml(
                                        movie.reason || ""
                                    )}

                                </div>

                            </div>

                        </article>

                    `
                )
                .join("");


        out.style.display =
            "grid";


    }catch(error){

        out.innerHTML = `

            <div
                class="error-box"
                style="grid-column:1/-1"
            >

                ${escapeHtml(
                    error.message
                )}

            </div>

        `;


        out.style.display =
            "grid";


    }finally{

        loading.style.display =
            "none";


        button.disabled =
            false;


        button.textContent =
            "FIND MY MOVIES";

    }

}


document
    .getElementById(
        "recommendButton"
    )
    .addEventListener(
        "click",
        findMovies
    );


/* =========================================================
   PANAYIOTIS PICKS
========================================================= */

function displayPicks(){

    const category =
        document.getElementById(
            "pickCategory"
        ).value;


    const grid =
        document.getElementById(
            "picksGrid"
        );


    const title =
        document.getElementById(
            "picksTitle"
        );


    title.textContent =
        PICK_GENRE_NAMES[
            category
        ];


    const catalog =
        window.PANAYIOTIS_CATALOG;


    if(
        !catalog ||
        !Array.isArray(
            catalog.movies
        )
    ){

        grid.innerHTML = `

            <div
                class="error-box"
                style="grid-column:1/-1"
            >

                Panayiotis' Picks catalog
                could not be loaded.

            </div>

        `;

        return;

    }


    const movieMap =
        new Map(
            catalog.movies.map(
                movie => [
                    movie.title,
                    movie
                ]
            )
        );


    const orderedTitles =
        catalog.categories &&
        Array.isArray(
            catalog.categories[
                category
            ]
        )
        ?
        catalog.categories[
            category
        ]
        :
        [];


    const movies =
        orderedTitles
            .map(
                title =>
                    movieMap.get(title)
            )
            .filter(Boolean)
            .slice(0,10);


    if(!movies.length){

        grid.innerHTML = `

            <div
                class="error-box"
                style="grid-column:1/-1"
            >

                No movies found in this category.

            </div>

        `;

        return;

    }


    grid.innerHTML =
        movies
            .map(
                (movie,index) => {

                    const poster =
                        movie.poster_path

                        ?

                        `
                        <img
                            class="pick-poster"
                            src="https://image.tmdb.org/t/p/w342${movie.poster_path}"
                            alt="${escapeAttr(
                                movie.title
                            )}"
                            loading="lazy"
                        >
                        `

                        :

                        `
                        <div
                            class="pick-poster"
                        ></div>
                        `;


                    const url =
                        movie.tmdb_id

                        ?

                        `https://www.themoviedb.org/movie/${movie.tmdb_id}`

                        :

                        `https://www.themoviedb.org/search/movie?query=${encodeURIComponent(
                            movie.title
                        )}`;


                    return `

                        <article
                            class="pick-card"
                        >

                            ${poster}


                            <div
                                class="pick-rank"
                            >

                                #${index + 1}

                            </div>


                            <div
                                class="pick-info"
                            >

                                <h3
                                    class="pick-title"
                                >

                                    ${escapeHtml(
                                        movie.title
                                    )}

                                </h3>


                                <div
                                    class="pick-year"
                                >

                                    ${escapeHtml(
                                        String(
                                            movie.year || ""
                                        )
                                    )}

                                </div>


                                <a
                                    class="pick-tmdb"
                                    href="${escapeAttr(
                                        url
                                    )}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >

                                    VIEW ON TMDB →

                                </a>

                            </div>


                            <div
                                class="pick-rating"
                            >

                                ${Number(
                                    movie.rating || 0
                                ).toFixed(1)}

                                / 5

                            </div>

                        </article>

                    `;

                }
            )
            .join("");


    initialize3DCards();

}


document
    .getElementById(
        "pickCategory"
    )
    .addEventListener(
        "change",
        displayPicks
    );


/* =========================================================
   3D PICKS
========================================================= */

function initialize3DCards(){

    const cards =
        document.querySelectorAll(
            ".pick-card"
        );


    if(
        !window.matchMedia(
            "(pointer:fine)"
        ).matches
    ){

        return;

    }


    cards.forEach(
        card => {

            card.addEventListener(
                "pointermove",
                event => {

                    const rect =
                        card.getBoundingClientRect();


                    const x =
                        (
                            event.clientX -
                            rect.left
                        ) /
                        rect.width -
                        .5;


                    const y =
                        (
                            event.clientY -
                            rect.top
                        ) /
                        rect.height -
                        .5;


                    card.style.setProperty(
                        "--rx",
                        `${(
                            -y * 9
                        ).toFixed(2)}deg`
                    );


                    card.style.setProperty(
                        "--ry",
                        `${(
                            x * 10
                        ).toFixed(2)}deg`
                    );


                    card.style.setProperty(
                        "--px",
                        `${(
                            x * 5
                        ).toFixed(2)}px`
                    );


                    card.style.setProperty(
                        "--py",
                        `${(
                            y * 5
                        ).toFixed(2)}px`
                    );


                    card.style.setProperty(
                        "--shine-x",
                        `${(
                            x + .5
                        ) * 100}%`
                    );


                    card.style.setProperty(
                        "--shine-y",
                        `${(
                            y + .5
                        ) * 100}%`
                    );


                    card.classList.add(
                        "tilting"
                    );

                },

                {
                    passive:true
                }
            );


            card.addEventListener(
                "pointerleave",
                () => {

                    card.style.setProperty(
                        "--rx",
                        "0deg"
                    );

                    card.style.setProperty(
                        "--ry",
                        "0deg"
                    );

                    card.style.setProperty(
                        "--px",
                        "0px"
                    );

                    card.style.setProperty(
                        "--py",
                        "0px"
                    );

                    card.classList.remove(
                        "tilting"
                    );

                },

                {
                    passive:true
                }
            );

        }
    );

}


/* =========================================================
   BACKGROUND PARALLAX
========================================================= */

(function(){

    const root =
        document.documentElement;


    if(
        !window.matchMedia(
            "(pointer:fine)"
        ).matches
    ){

        return;

    }


    let targetX = 0;

    let targetY = 0;

    let currentX = 0;

    let currentY = 0;


    window.addEventListener(
        "pointermove",
        event => {

            targetX =
                (
                    event.clientX /
                    window.innerWidth -
                    .5
                ) * -16;


            targetY =
                (
                    event.clientY /
                    window.innerHeight -
                    .5
                ) * -11;


            root.style.setProperty(
                "--mouse-x",
                `${
                    (
                        event.clientX /
                        window.innerWidth
                    ) * 100
                }%`
            );


            root.style.setProperty(
                "--mouse-y",
                `${
                    (
                        event.clientY /
                        window.innerHeight
                    ) * 100
                }%`
            );

        },

        {
            passive:true
        }
    );


    function animate(){

        currentX +=
            (
                targetX -
                currentX
            ) * .05;


        currentY +=
            (
                targetY -
                currentY
            ) * .05;


        root.style.setProperty(
            "--bg-x",
            `${currentX.toFixed(2)}px`
        );


        root.style.setProperty(
            "--bg-y",
            `${currentY.toFixed(2)}px`
        );


        requestAnimationFrame(
            animate
        );

    }


    animate();

})();


/* =========================================================
   SECURITY
========================================================= */

function escapeHtml(value){

    return String(
        value ?? ""
    )

    .replace(
        /&/g,
        "&amp;"
    )

    .replace(
        /</g,
        "&lt;"
    )

    .replace(
        />/g,
        "&gt;"
    )

    .replace(
        /"/g,
        "&quot;"
    )

    .replace(
        /'/g,
        "&#039;"
    );

}


function escapeAttr(value){

    return String(
        value ?? ""
    )

    .replace(
        /&/g,
        "&amp;"
    )

    .replace(
        /"/g,
        "&quot;"
    )

    .replace(
        /</g,
        "&lt;"
    )

    .replace(
        />/g,
        "&gt;"
    );

}


/* =========================================================
   INITIALIZE
========================================================= */

displayPicks();

</script>

