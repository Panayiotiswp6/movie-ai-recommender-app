<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>MovieMind AI</title>

<meta
    name="description"
    content="MovieMind AI — personalized movie recommendations created by Panayiotis Kouzaris."
>

<script src="./panayiotis-picks.js"></script>

<style>

/* =========================================================
   BASE
========================================================= */

*{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

:root{

    --mouse-x:50%;
    --mouse-y:50%;

    --bg-x:0px;
    --bg-y:0px;

    --blue:#5bb7ff;
    --blue2:#287dff;
    --blue3:#174dbb;

    --white:#f5f9ff;

    --muted:rgba(225,237,255,.62);

    --glass:
        rgba(3,11,25,.55);

}

body{

    margin:0;

    min-height:100vh;

    color:#fff;

    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background:#020711;

    overflow-x:hidden;
}


/* =========================================================
   CINEMATIC BACKGROUND
========================================================= */

body::before{

    content:"";

    position:fixed;

    inset:-7%;

    z-index:-10;

    background:

        linear-gradient(
            180deg,
            rgba(1,5,14,.14),
            rgba(1,5,14,.45)
        ),

        url("IMG_1106.png")
        center/cover no-repeat;

    transform:
        translate3d(
            var(--bg-x),
            var(--bg-y),
            0
        )
        scale(1.08);

    will-change:transform;
}


body::after{

    content:"";

    position:fixed;

    inset:0;

    z-index:-9;

    pointer-events:none;

    background:

        radial-gradient(
            circle at
            var(--mouse-x)
            var(--mouse-y),

            rgba(80,170,255,.10),

            transparent 27%
        ),

        linear-gradient(
            180deg,
            rgba(0,0,0,.04),
            rgba(0,0,0,.32) 58%,
            rgba(0,0,0,.80) 100%
        );
}


.ambient-grid{

    position:fixed;

    inset:0;

    z-index:-8;

    pointer-events:none;

    opacity:.09;

    background-image:

        linear-gradient(
            rgba(255,255,255,.045) 1px,
            transparent 1px
        ),

        linear-gradient(
            90deg,
            rgba(255,255,255,.045) 1px,
            transparent 1px
        );

    background-size:80px 80px;

    mask-image:
        linear-gradient(
            to bottom,
            transparent,
            #000 25%,
            #000 75%,
            transparent
        );
}


.ambient-light{

    position:fixed;

    width:40vw;

    height:40vw;

    border-radius:50%;

    z-index:-7;

    pointer-events:none;

    background:
        radial-gradient(
            circle,
            rgba(40,130,255,.13),
            transparent 68%
        );

    filter:blur(30px);

    animation:
        ambientFloat
        13s
        ease-in-out
        infinite
        alternate;
}


.ambient-light.one{
    top:-10%;
    right:-10%;
}


.ambient-light.two{
    bottom:-15%;
    left:-15%;

    animation-delay:-5s;
}


@keyframes ambientFloat{

    to{

        transform:
            translate3d(
                -35px,
                25px,
                0
            )
            scale(1.08);

    }

}


/* =========================================================
   CONTAINER
========================================================= */

.container{

    width:
        min(
            1180px,
            calc(100% - 36px)
        );

    margin:auto;

    padding:
        20px
        0
        80px;
}


/* =========================================================
   TOP NAV
========================================================= */

.mode-switch{

    position:sticky;

    top:16px;

    z-index:100;

    width:max-content;

    margin:
        0
        auto
        20px;

    display:flex;

    gap:5px;

    padding:6px;

    border:
        1px solid
        rgba(255,255,255,.15);

    border-radius:999px;

    background:
        rgba(4,10,22,.72);

    backdrop-filter:
        blur(22px);

    box-shadow:
        0 18px 60px
        rgba(0,0,0,.32);
}


.mode-button{

    border:0;

    border-radius:999px;

    padding:
        11px
        18px;

    color:
        rgba(
            230,
            240,
            255,
            .62
        );

    background:transparent;

    font-size:10px;

    font-weight:900;

    letter-spacing:.11em;

    transition:
        .3s ease;
}


.mode-button:hover{

    color:#fff;

    background:
        rgba(255,255,255,.07);

    transform:
        translateY(-1px);
}


.mode-button.active{

    color:#fff;

    background:
        linear-gradient(
            135deg,
            rgba(74,153,255,.82),
            rgba(27,74,180,.78)
        );

    box-shadow:
        0 8px 25px
        rgba(34,117,255,.24),

        inset
        0 0 0 1px
        rgba(255,255,255,.18);
}


/* =========================================================
   MODES
========================================================= */

.mode-content{
    display:none;
}

.mode-content.active{
    display:block;
}


/* =========================================================
   HERO
========================================================= */

.hero{

    position:relative;

    min-height:
        calc(
            100vh - 90px
        );

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    text-align:center;

    padding:
        30px
        10px
        100px;
}


.hero::before{

    content:"";

    position:absolute;

    width:
        min(
            750px,
            90vw
        );

    height:320px;

    top:50%;

    left:50%;

    transform:
        translate(
            -50%,
            -50%
        );

    background:
        radial-gradient(
            ellipse,
            rgba(35,125,255,.16),
            transparent 70%
        );

    filter:blur(25px);

    pointer-events:none;

    z-index:-1;
}


.eyebrow{

    display:inline-flex;

    align-items:center;

    gap:9px;

    padding:
        8px
        13px;

    border:
        1px solid
        rgba(255,255,255,.16);

    border-radius:999px;

    background:
        rgba(5,12,25,.38);

    backdrop-filter:
        blur(12px);

    font-size:10px;

    font-weight:800;

    letter-spacing:.18em;

    color:
        rgba(
            235,
            243,
            255,
            .82
        );

    animation:
        heroFade
        .9s
        ease
        both;
}


.eyebrow i{

    width:6px;

    height:6px;

    border-radius:50%;

    background:#69b8ff;

    box-shadow:
        0 0 16px
        #69b8ff;
}


.hero h1{

    margin:
        26px
        0
        16px;

    font-size:
        clamp(
            72px,
            13vw,
            170px
        );

    line-height:.76;

    letter-spacing:-.075em;

    font-weight:950;

    text-shadow:
        0 25px 80px
        rgba(0,0,0,.58);

    animation:
        heroTitle
        1s
        .08s
        ease
        both;
}


.hero h1 span{

    display:block;

    background:
        linear-gradient(
            180deg,
            #fff 5%,
            #b7ddff 38%,
            #398cff 90%
        );

    -webkit-background-clip:text;

    background-clip:text;

    -webkit-text-fill-color:
        transparent;
}


.hero p{

    max-width:670px;

    margin:
        24px
        auto
        0;

    color:
        rgba(
            234,
            241,
            252,
            .76
        );

    font-size:
        clamp(
            15px,
            2vw,
            19px
        );

    line-height:1.65;

    animation:
        heroFade
        1s
        .22s
        ease
        both;
}


.creator{

    margin-top:18px;

    color:
        rgba(
            230,
            239,
            250,
            .65
        );

    font-size:13px;

    animation:
        heroFade
        1s
        .34s
        ease
        both;
}


.creator strong{
    color:#72bcff;
}


.explore-button{

    position:absolute;

    bottom:28px;

    border:0;

    background:transparent;

    color:
        rgba(
            255,
            255,
            255,
            .52
        );

    font-size:9px;

    letter-spacing:.22em;

    display:flex;

    flex-direction:column;

    align-items:center;

    gap:9px;

    cursor:pointer;
}


.explore-button span{

    display:block;

    width:1px;

    height:42px;

    background:
        linear-gradient(
            #72bcff,
            transparent
        );

    animation:
        exploreLine
        1.8s
        ease-in-out
        infinite;
}


/* =========================================================
   NEW DIGITAL AI INTERFACE
========================================================= */

.ai-section{

    padding-top:30px;

    padding-bottom:30px;
}


/*
   This replaces the old rectangular
   "dashboard" appearance.
*/

.ai-interface{

    position:relative;

    padding:
        clamp(
            26px,
            5vw,
            48px
        );

    border:
        1px solid
        rgba(
            130,
            195,
            255,
            .18
        );

    border-radius:38px;

    background:

        radial-gradient(
            circle at
            10% 0%,
            rgba(
                76,
                159,
                255,
                .11
            ),
            transparent 32%
        ),

        radial-gradient(
            circle at
            100% 100%,
            rgba(
                35,
                98,
                255,
                .09
            ),
            transparent 30%
        ),

        rgba(
            3,
            9,
            22,
            .47
        );

    backdrop-filter:
        blur(24px);

    box-shadow:

        0 45px 120px
        rgba(0,0,0,.38),

        inset
        0 1px
        rgba(255,255,255,.08);

    overflow:hidden;
}


.ai-interface::before{

    content:"";

    position:absolute;

    inset:0;

    pointer-events:none;

    border-radius:inherit;

    background:
        linear-gradient(
            120deg,
            transparent 20%,
            rgba(110,190,255,.07),
            transparent 60%
        );

    opacity:.8;
}


.ai-top{

    position:relative;

    display:flex;

    justify-content:space-between;

    align-items:flex-end;

    gap:30px;

    margin-bottom:38px;
}


.ai-kicker{

    display:flex;

    align-items:center;

    gap:10px;

    margin-bottom:13px;

    color:#6ebdff;

    font-size:10px;

    font-weight:900;

    letter-spacing:.22em;

    text-transform:uppercase;
}


.ai-kicker::before{

    content:"";

    width:27px;

    height:1px;

    background:
        linear-gradient(
            90deg,
            #69bcff,
            transparent
        );
}


.ai-title{

    margin:0;

    font-size:
        clamp(
            34px,
            5vw,
            58px
        );

    line-height:.95;

    letter-spacing:-.055em;

    font-weight:850;
}


.ai-description{

    max-width:470px;

    margin:0;

    color:
        rgba(
            225,
            237,
            255,
            .56
        );

    font-size:14px;

    line-height:1.7;
}


/* =========================================================
   DIGITAL CONTROL GRID
========================================================= */

.ai-controls{

    position:relative;

    display:grid;

    grid-template-columns:
        repeat(
            3,
            1fr
        );

    gap:16px;

    margin-bottom:26px;
}


/*
   The old square select boxes are replaced
   by floating capsules.
*/

.control{

    position:relative;

    min-height:128px;

    padding:
        20px
        20px
        18px;

    border:
        1px solid
        rgba(
            130,
            195,
            255,
            .15
        );

    border-radius:27px;

    background:
        linear-gradient(
            145deg,
            rgba(12,30,57,.58),
            rgba(3,12,27,.40)
        );

    box-shadow:
        inset
        0 1px
        rgba(255,255,255,.055),

        0 18px 45px
        rgba(0,0,0,.16);

    transition:
        border-color .3s ease,
        transform .3s ease,
        box-shadow .3s ease;

    overflow:hidden;
}


.control::before{

    content:"";

    position:absolute;

    width:130px;

    height:130px;

    top:-75px;

    right:-55px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(82,170,255,.15),
            transparent 70%
        );

    pointer-events:none;
}


.control:hover{

    transform:
        translateY(-4px);

    border-color:
        rgba(
            105,
            190,
            255,
            .35
        );

    box-shadow:

        0 25px 55px
        rgba(0,0,0,.24),

        inset
        0 1px
        rgba(255,255,255,.08);
}


.control-label{

    display:flex;

    align-items:center;

    gap:8px;

    margin-bottom:13px;

    color:
        rgba(
            225,
            238,
            255,
            .58
        );

    font-size:9px;

    font-weight:900;

    letter-spacing:.17em;

    text-transform:uppercase;
}


.control-label::before{

    content:"";

    width:5px;

    height:5px;

    border-radius:50%;

    background:#5eb5ff;

    box-shadow:
        0 0 10px
        rgba(
            94,
            181,
            255,
            .75
        );
}


/*
   Custom-looking select.
*/

.digital-select{

    position:relative;

    width:100%;

    appearance:none;

    -webkit-appearance:none;

    border:0;

    outline:0;

    padding:
        0
        32px
        0
        0;

    color:#fff;

    background:transparent;

    font-size:17px;

    font-weight:750;

    letter-spacing:-.02em;

    cursor:pointer;
}


.digital-select option{

    background:#071426;

    color:#fff;
}


.control::after{

    content:"";

    position:absolute;

    right:20px;

    bottom:23px;

    width:8px;

    height:8px;

    border-right:
        1.5px solid
        #7ec8ff;

    border-bottom:
        1.5px solid
        #7ec8ff;

    transform:
        rotate(45deg);

    pointer-events:none;
}


/* =========================================================
   FAVORITE MOVIES
========================================================= */

.favorite-area{

    position:relative;

    padding-top:10px;
}


.favorite-heading{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;

    margin-bottom:13px;
}


.favorite-title{

    color:
        rgba(
            225,
            238,
            255,
            .60
        );

    font-size:10px;

    font-weight:900;

    letter-spacing:.17em;

    text-transform:uppercase;
}


.favorite-count{

    color:
        rgba(
            110,
            190,
            255,
            .55
        );

    font-size:9px;

    font-weight:800;

    letter-spacing:.12em;
}


.favorite-grid{

    display:grid;

    grid-template-columns:
        repeat(
            3,
            1fr
        );

    gap:12px;
}


.favorite-input{

    position:relative;
}


.favorite-input::before{

    content:"+";

    position:absolute;

    left:17px;

    top:50%;

    transform:
        translateY(-52%);

    z-index:2;

    color:
        rgba(
            112,
            190,
            255,
            .70
        );

    font-size:18px;

    font-weight:300;

    pointer-events:none;
}


.favorite-input input{

    width:100%;

    height:57px;

    padding:
        0
        18px
        0
        42px;

    border:
        1px solid
        rgba(
            130,
            195,
            255,
            .14
        );

    border-radius:999px;

    outline:none;

    color:#fff;

    background:
        rgba(
            1,
            9,
            21,
            .52
        );

    font-size:13px;

    font-weight:600;

    transition:
        border-color .3s ease,
        background .3s ease,
        box-shadow .3s ease,
        transform .3s ease;
}


.favorite-input input::placeholder{

    color:
        rgba(
            220,
            235,
            255,
            .34
        );
}


.favorite-input input:hover{

    background:
        rgba(
            5,
            20,
            39,
            .68
        );

    border-color:
        rgba(
            105,
            190,
            255,
            .28
        );
}


.favorite-input input:focus{

    border-color:
        rgba(
            100,
            190,
            255,
            .60
        );

    background:
        rgba(
            5,
            20,
            39,
            .78
        );

    box-shadow:
        0 0 0 4px
        rgba(
            65,
            143,
            255,
            .09
        ),

        0 10px 35px
        rgba(
            20,
            110,
            255,
            .10
        );

    transform:
        translateY(-2px);
}


/* =========================================================
   DIGITAL FIND BUTTON
========================================================= */

.find-button{

    position:relative;

    overflow:hidden;

    width:100%;

    min-height:67px;

    margin-top:27px;

    border:
        1px solid
        rgba(
            145,
            210,
            255,
            .30
        );

    border-radius:999px;

    color:#fff;

    background:

        radial-gradient(
            circle at
            25% 20%,
            rgba(255,255,255,.22),
            transparent 18%
        ),

        linear-gradient(
            110deg,
            #155bdc,
            #318dff 50%,
            #1953c7
        );

    box-shadow:

        0 18px 55px
        rgba(
            25,
            111,
            255,
            .27
        ),

        inset
        0 1px
        rgba(255,255,255,.22);

    font-size:12px;

    font-weight:950;

    letter-spacing:.18em;

    cursor:pointer;

    transition:
        transform .3s ease,
        box-shadow .3s ease;
}


.find-button::before{

    content:"";

    position:absolute;

    inset:-100%;

    background:
        linear-gradient(
            110deg,
            transparent 35%,
            rgba(255,255,255,.32),
            transparent 65%
        );

    transform:
        translateX(-70%)
        rotate(8deg);

    animation:
        buttonSweep
        4s
        ease-in-out
        infinite;
}


.find-button::after{

    content:"→";

    position:absolute;

    right:24px;

    top:50%;

    transform:
        translateY(-50%);

    font-size:19px;

    font-weight:300;

    transition:
        transform .3s ease;
}


.find-button:hover{

    transform:
        translateY(-3px);

    box-shadow:

        0 25px 70px
        rgba(
            25,
            111,
            255,
            .38
        ),

        inset
        0 1px
        rgba(255,255,255,.26);
}


.find-button:hover::after{

    transform:
        translate(
            5px,
            -50%
        );
}


.find-button:disabled{

    opacity:.65;

    cursor:wait;
}


/* =========================================================
   RESULTS
========================================================= */

.results{

    margin-top:80px;
}


.results h2{

    margin-bottom:24px;

    font-size:
        clamp(
            30px,
            5vw,
            48px
        );

    letter-spacing:-.04em;
}


.loading{

    padding:50px;

    text-align:center;

    border:
        1px solid
        rgba(
            255,
            255,
            255,
            .11
        );

    border-radius:22px;

    background:
        rgba(
            3,
            11,
            24,
            .48
        );

    backdrop-filter:
        blur(15px);
}


.spinner{

    width:42px;

    height:42px;

    margin:
        0
        auto
        16px;

    border:
        2px solid
        rgba(
            255,
            255,
            255,
            .13
        );

    border-top-color:#61b4ff;

    border-right-color:#277cff;

    border-radius:50%;

    animation:
        spin
        1s
        linear
        infinite;
}


.movie-grid{

    display:grid;

    grid-template-columns:
        repeat(
            2,
            1fr
        );

    gap:18px;
}


.movie-card{

    position:relative;

    display:flex;

    gap:17px;

    min-height:190px;

    padding:14px;

    border:
        1px solid
        rgba(
            255,
            255,
            255,
            .12
        );

    border-radius:20px;

    background:
        rgba(
            3,
            11,
            24,
            .52
        );

    backdrop-filter:
        blur(12px);

    box-shadow:
        0 25px 55px
        rgba(0,0,0,.28);

    overflow:hidden;

    transition:
        transform .35s ease,
        border-color .35s ease,
        box-shadow .35s ease;
}


.movie-card:hover{

    transform:
        translateY(-7px);

    border-color:
        rgba(
            112,
            190,
            255,
            .36
        );

    box-shadow:
        0 35px 75px
        rgba(0,0,0,.38);
}


.movie-card img{

    width:110px;

    height:162px;

    object-fit:cover;

    border-radius:11px;

    flex:none;

    box-shadow:
        0 18px 35px
        rgba(0,0,0,.4);

    transition:
        transform .45s
        cubic-bezier(
            .2,
            .8,
            .2,
            1
        );
}


.movie-card:hover img{

    transform:
        translateZ(22px)
        scale(1.035);
}


.movie-info{

    min-width:0;

    align-self:center;
}


.movie-info h3{

    margin:
        0
        0
        7px;

    font-size:19px;
}


.movie-meta{

    margin-bottom:9px;

    color:#70bfff;

    font-size:12px;
}


.movie-rating{

    display:inline-block;

    margin-bottom:9px;

    padding:
        5px
        9px;

    border-radius:999px;

    background:
        rgba(
            255,
            193,
            7,
            .11
        );

    color:#ffd76a;

    font-size:11px;

    font-weight:900;
}


.movie-reason{

    color:
        rgba(
            225,
            235,
            250,
            .67
        );

    font-size:13px;

    line-height:1.55;
}


/* =========================================================
   PICKS
========================================================= */

#picksMode{

    padding-top:60px;
}


.picks-top{

    display:flex;

    align-items:flex-end;

    justify-content:space-between;

    gap:30px;

    margin-bottom:35px;
}


.section-title{

    margin:0;

    font-size:
        clamp(
            34px,
            6vw,
            62px
        );

    line-height:1;

    letter-spacing:-.05em;
}


.category-select{

    min-width:220px;

    padding:
        14px
        16px;

    border:
        1px solid
        rgba(
            255,
            255,
            255,
            .16
        );

    border-radius:14px;

    color:#fff;

    background:
        rgba(
            3,
            11,
            24,
            .62
        );

    backdrop-filter:
        blur(14px);

    outline:none;

    cursor:pointer;
}


.category-select option{

    background:#071426;

    color:#fff;
}


.picks-grid{

    display:grid;

    grid-template-columns:
        repeat(
            2,
            1fr
        );

    gap:20px;

    perspective:1600px;
}


.pick-card{

    --rx:0deg;
    --ry:0deg;
    --px:0px;
    --py:0px;
    --shine-x:50%;
    --shine-y:50%;

    position:relative;

    display:flex;

    align-items:center;

    gap:14px;

    min-height:168px;

    padding:13px;

    border:
        1px solid
        rgba(
            255,
            255,
            255,
            .14
        );

    border-radius:21px;

    background:
        linear-gradient(
            135deg,
            rgba(3,12,26,.58),
            rgba(2,9,20,.32)
        );

    backdrop-filter:
        blur(9px);

    box-shadow:
        0 24px 55px
        rgba(0,0,0,.27);

    transform-style:preserve-3d;

    transform:
        perspective(1000px)
        rotateX(var(--rx))
        rotateY(var(--ry))
        translate3d(
            var(--px),
            var(--py),
            0
        );

    transition:
        transform .12s ease-out,
        border-color .3s ease,
        box-shadow .3s ease;

    overflow:hidden;
}


.pick-card::before{

    content:"";

    position:absolute;

    inset:-20%;

    pointer-events:none;

    background:
        radial-gradient(
            circle at
            var(--shine-x)
            var(--shine-y),

            rgba(
                105,
                187,
                255,
                .20
            ),

            transparent 25%
        );
}


.pick-card.tilting{

    border-color:
        rgba(
            104,
            185,
            255,
            .42
        );

    box-shadow:
        0 38px 90px
        rgba(0,0,0,.42),

        0 0 45px
        rgba(
            45,
            137,
            255,
            .10
        );
}


.pick-poster{

    width:100px;

    height:146px;

    object-fit:cover;

    border-radius:10px;

    flex:none;

    background:#071426;

    box-shadow:
        0 20px 35px
        rgba(0,0,0,.42);

    transform:
        translateZ(34px);

    transition:
        transform .25s ease;

    position:relative;

    z-index:2;
}


.pick-card.tilting .pick-poster{

    transform:
        translateZ(58px)
        scale(1.045);
}


.pick-rank{

    width:34px;

    height:34px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex:none;

    border:
        1px solid
        rgba(
            105,
            187,
            255,
            .22
        );

    border-radius:50%;

    background:
        rgba(
            35,
            111,
            220,
            .18
        );

