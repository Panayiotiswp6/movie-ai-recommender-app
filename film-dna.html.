<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MovieMind AI — Your Film DNA</title>
<meta name="description" content="MovieMind Film DNA — analyze your Letterboxd movie history locally in your browser.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
<style>
:root{--ink:#eaf2fb;--ink-dim:rgba(234,242,251,.66);--ink-faint:rgba(234,242,251,.40);--floor:#030509;--panel:rgba(6,10,20,.64);--panel-soft:rgba(9,14,26,.44);--teal:#3fa7c4;--teal-bright:#7fd4ea;--orange:#c1512e;--orange-bright:#e8815a;--line:rgba(150,210,230,.16);--radius-lg:26px;--radius-md:16px;--serif:'Fraunces',ui-serif,Georgia,serif;--sans:'Inter',ui-sans-serif,system-ui,-apple-system,sans-serif;--mouse-x:50%;--mouse-y:50%;--bg-x:0px;--bg-y:0px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;color:var(--ink);font-family:var(--sans);background:var(--floor);overflow-x:hidden}
body::before{content:"";position:fixed;inset:-6%;z-index:-12;pointer-events:none;background:linear-gradient(180deg,rgba(3,6,12,.55),rgba(2,4,9,.80) 55%,rgba(1,2,6,.94)),linear-gradient(200deg,rgba(20,60,80,.35),rgba(90,30,10,.20)),url("IMG_1106.png") center/cover no-repeat;background-blend-mode:normal,color,normal;transform:translate3d(var(--bg-x),var(--bg-y),0) scale(1.08)}
body::after{content:"";position:fixed;inset:0;z-index:-9;pointer-events:none;background:radial-gradient(circle at var(--mouse-x) var(--mouse-y),rgba(127,212,234,.10),transparent 32%),radial-gradient(ellipse 1200px 700px at 50% 100%,rgba(1,2,5,.8),transparent 60%)}
.grain{position:fixed;inset:0;z-index:-8;pointer-events:none;opacity:.045;mix-blend-mode:overlay;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>")}
.container{width:min(1120px,calc(100% - 32px));margin:auto;padding:20px 0 90px}.topbar{position:sticky;top:16px;z-index:50;display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:55px}.brand,.back{padding:10px 14px;border:1px solid var(--line);border-radius:999px;background:rgba(4,7,14,.68);backdrop-filter:blur(18px)}.brand{font:800 11px/1 var(--sans);letter-spacing:.16em}.brand span{color:var(--teal-bright)}.back{color:var(--ink-dim);text-decoration:none;font:700 10px/1 var(--sans);letter-spacing:.08em}.hero{max-width:800px;margin:0 auto 34px;text-align:center}.kicker{color:var(--teal-bright);font:700 12px/1 var(--sans);margin-bottom:14px}h1{margin:0;font-family:var(--serif);font-size:clamp(52px,9vw,100px);line-height:.9;font-weight:600;letter-spacing:-.025em;text-shadow:0 10px 50px rgba(0,0,0,.6)}h1 em{font-style:italic;background:linear-gradient(120deg,var(--teal-bright),var(--orange-bright));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}.hero p{max-width:650px;margin:20px auto 0;color:var(--ink-dim);font-size:14px;line-height:1.7}.upload{max-width:820px;margin:auto;padding:10px;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--panel);backdrop-filter:blur(26px);box-shadow:0 55px 110px rgba(0,0,0,.55)}.dropzone{min-height:250px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 24px;text-align:center;border:1px dashed rgba(127,212,234,.28);border-radius:20px;background:radial-gradient(circle at 50% 0%,rgba(63,167,196,.11),transparent 50%),rgba(3,5,10,.28);transition:.25s ease}.dropzone:hover,.dropzone.dragging{border-color:rgba(127,212,234,.65);transform:translateY(-2px)}.orb{width:60px;height:60px;display:grid;place-items:center;margin-bottom:16px;border:1px solid rgba(127,212,234,.3);border-radius:50%;color:var(--teal-bright);background:rgba(63,167,196,.10);box-shadow:0 0 35px rgba(63,167,196,.12);font-family:var(--serif);font-size:26px}.dropzone h2{margin:0 0 7px;font-family:var(--serif);font-size:23px;font-weight:600}.dropzone p{max-width:520px;margin:0 0 20px;color:var(--ink-faint);font-size:12px;line-height:1.6}.file-button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 20px;border-radius:999px;color:#04141a;background:linear-gradient(120deg,var(--teal-bright),var(--teal));font:800 11px/1 var(--sans);letter-spacing:.06em;cursor:pointer}.file-button input{display:none}.status{min-height:18px;margin:11px auto 0;text-align:center;color:var(--ink-faint);font-size:11px}.status.error{color:#f6c9b6}.privacy{margin:10px auto 0;text-align:center;color:var(--ink-faint);font-size:10px}.privacy strong{color:var(--teal-bright)}.dashboard{margin-top:46px}.dashboard[hidden]{display:none}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.card{border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel);backdrop-filter:blur(20px);box-shadow:0 25px 65px rgba(0,0,0,.38)}.metric{min-height:130px;padding:22px 19px;display:flex;flex-direction:column;justify-content:space-between}.metric strong{font-family:var(--serif);font-size:34px;font-weight:600}.metric span,.record span{color:var(--ink-faint);font:700 9px/1 var(--sans);letter-spacing:.15em}.heading{margin:48px 0 16px}.heading h3{margin:0;font-family:var(--serif);font-size:27px;font-weight:600}.heading p{margin:7px 0 0;color:var(--ink-faint);font-size:12px}.panel{padding:22px}.chart{display:flex;flex-direction:column;gap:11px}.bar-row{display:grid;grid-template-columns:46px 1fr 42px;align-items:center;gap:10px;font-size:10px}.bar-row.decade{grid-template-columns:64px 1fr 72px}.bar-label{color:var(--ink-faint)}.track{height:8px;overflow:hidden;border-radius:999px;background:rgba(255,255,255,.055)}.fill{height:100%;min-width:2px;border-radius:999px;background:linear-gradient(90deg,var(--teal),var(--teal-bright))}.count{color:var(--ink-dim);text-align:right}.decade-value{color:var(--orange-bright);text-align:right}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.panel h4{margin:0 0 17px;font-family:var(--serif);font-size:18px;font-weight:600}.list{display:flex;flex-direction:column}.list-row{display:grid;grid-template-columns:32px 1fr auto;gap:11px;align-items:center;padding:12px 0;border-bottom:1px solid rgba(150,210,230,.08)}.list-row:last-child{border-bottom:0}.rank{color:var(--teal-bright);font-size:10px;font-weight:800}.main{min-width:0}.main strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}.main span{display:block;margin-top:3px;color:var(--ink-faint);font-size:10px}.rating{color:var(--orange-bright);font-size:11px;font-weight:800}.records{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.record{padding:18px}.record span{display:block;margin-bottom:9px}.record strong{font-family:var(--serif);font-size:17px;font-weight:600}.insights{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.insight{min-height:108px;padding:19px;border:1px solid rgba(150,210,230,.11);border-radius:var(--radius-md);background:linear-gradient(135deg,rgba(63,167,196,.09),rgba(193,81,46,.05)),var(--panel-soft);color:var(--ink-dim);font-size:12px;line-height:1.65}.insight strong{display:block;margin-bottom:7px;color:var(--ink);font-family:var(--serif);font-size:16px}.reset{display:block;margin:36px auto 0;border:1px solid var(--line);border-radius:999px;padding:11px 18px;color:var(--ink-dim);background:rgba(4,7,14,.58);font:700 10px/1 var(--sans);letter-spacing:.08em;cursor:pointer}.footer{margin-top:65px;padding-top:22px;border-top:1px solid var(--line);text-align:center;color:var(--ink-faint);font-size:10px;line-height:1.7}
@media(max-width:800px){.metrics,.records{grid-template-columns:1fr 1fr}.grid,.insights{grid-template-columns:1fr}}@media(max-width:520px){.container{width:calc(100% - 20px)}.metrics,.records{grid-template-columns:1fr}.panel{padding:18px}}
</style>
</head>
<body>
<div class="grain"></div>
<main class="container">
<header class="topbar">
  <div class="brand">MOVIEMIND <span>/ FILM DNA</span></div>
  <a class="back" href="./index.html">BACK TO MOVIEMIND</a>
</header>
<section class="hero">
  <div class="kicker">Personal cinema intelligence</div>
  <h1>Your <em>Film DNA</em></h1>
  <p>Bring your Letterboxd export and turn your movie history into a cinematic profile — ratings, eras, habits, records and patterns — with the analysis staying inside your browser.</p>
</section>
<section class="upload">
  <div class="dropzone" id="filmDnaDropzone">
    <div class="orb">◌</div>
    <h2>Enter your movie universe</h2>
    <p>Export your data from Letterboxd as a ZIP, then drop it here. The raw export is not uploaded to MovieMind.</p>
    <label class="file-button">CHOOSE LETTERBOXD ZIP<input id="letterboxdUpload" type="file" accept=".zip,application/zip"></label>
  </div>
</section>
<div class="status" id="filmDnaStatus">Waiting for your Letterboxd export.</div>
<div class="privacy"><strong>LOCAL BY DESIGN</strong> · Your ZIP is read in this browser.</div>
<section class="dashboard" id="filmDnaDashboard" hidden>
  <div class="metrics">
    <div class="card metric"><strong id="dnaMetricWatched">0</strong><span>FILMS WATCHED</span></div>
    <div class="card metric"><strong id="dnaMetricRated">0</strong><span>FILMS RATED</span></div>
    <div class="card metric"><strong id="dnaMetricAverage">0.00★</strong><span>AVERAGE RATING</span></div>
    <div class="card metric"><strong id="dnaMetricElite">0</strong><span>4.5★+ FILMS</span></div>
  </div>
  <div class="heading"><h3>Your rating personality</h3><p>The shape of your personal Letterboxd rating curve.</p></div>
  <div class="card panel"><div class="chart" id="dnaRatingChart"></div></div>
  <div class="heading"><h3>Your cinematic eras</h3><p>Which release decades dominate your movie history.</p></div>
  <div class="card panel"><div class="chart" id="dnaDecadeChart"></div></div>
  <div class="heading"><h3>Your movie journey</h3><p>The years and films that appear most often in your data.</p></div>
  <div class="grid">
    <div class="card panel"><h4>Most represented years</h4><div class="list" id="dnaYearList"></div></div>
    <div class="card panel"><h4>Personal records</h4><div class="records">
      <div class="card record"><span>RELEASE RANGE</span><strong id="dnaRecordRelease">—</strong></div>
      <div class="card record"><span>WATCHED UNRATED</span><strong id="dnaRecordUnrated">—</strong></div>
      <div class="card record"><span>UNIQUE RATED</span><strong id="dnaRecordUnique">—</strong></div>
      <div class="card record"><span>DIARY ENTRIES</span><strong id="dnaRecordDiary">—</strong></div>
    </div></div>
  </div>
  <div class="heading"><h3>Your personal extremes</h3><p>The titles sitting at the top and bottom of your rating scale.</p></div>
  <div class="grid">
    <div class="card panel"><h4>Highest-rated films</h4><div class="list" id="dnaTopFilms"></div></div>
    <div class="card panel"><h4>Lowest-rated films</h4><div class="list" id="dnaLowFilms"></div></div>
  </div>
  <div class="heading"><h3>Your Letterboxd footprint</h3><p>Activity signals that can be read directly from the export.</p></div>
  <div class="records">
    <div class="card record"><span>5★ FILMS</span><strong id="dnaFiveStar">0</strong></div>
    <div class="card record"><span>4★+ FILMS</span><strong id="dnaFourPlus">0</strong></div>
    <div class="card record"><span>2★ OR LESS</span><strong id="dnaTwoLess">0</strong></div>
    <div class="card record"><span>WATCHLIST</span><strong id="dnaWatchlist">0</strong></div>
    <div class="card record"><span>DIARY</span><strong id="dnaDiary">0</strong></div>
    <div class="card record"><span>REVIEWS</span><strong id="dnaReviews">0</strong></div>
    <div class="card record"><span>REWATCHES</span><strong id="dnaRewatches">0</strong></div>
    <div class="card record"><span>RATING RANGE</span><strong id="dnaRatingRange">—</strong></div>
  </div>
  <div class="heading"><h3>The MovieMind read</h3><p>Observations derived from the numbers in your export.</p></div>
  <div class="insights" id="dnaInsights"></div>
  <button class="reset" id="filmDnaReset" type="button">ANALYZE ANOTHER EXPORT</button>
</section>
<footer class="footer">MovieMind · Your Film DNA<br>Letterboxd export analysis happens locally in your browser.</footer>
</main>
<script src="./film-dna.js"></script>
</body>
</html>
